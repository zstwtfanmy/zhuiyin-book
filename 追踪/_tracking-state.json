  "timeline": {
    "E001": {
      "characters": [
        "沈亦舟",
        "李婶",
        "王浩"
      ],
      "first_recorded_chapter": 1,
      "id": "E001",
      "objective_fact": "他说李婶家孩子是要抽，嘱咐别让他睡沉；当夜孩子抽搐送医，医生说法与他一字不差。",
      "reader_knowledge": "读者已知：这孩子有本事，无人知来源",
      "reveal_chapter": 1,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·开学第一天",
      "updated_chapter": 1
    },
    "E002": {
      "characters": [
        "李国强",
        "沈建国",
        "沈亦舟"
      ],
      "first_recorded_chapter": 1,
      "id": "E002",
      "objective_fact": "李国强登门羞辱沈建国：你这辈子也就这样了。全家无人接话。",
      "reader_knowledge": "读者已知：这家很穷且被人看不起",
      "reveal_chapter": 1,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·同日傍晚",
      "updated_chapter": 1
    },
    "E003": {
      "characters": [
        "沈亦舟",
        "李秀兰",
        "张叔"
      ],
      "first_recorded_chapter": 2,
      "id": "E003",
      "objective_fact": "他问起院门口的槐树，老妈说一直都没有；同日巷口张家的车丢了，锁是好的。两件事他没往一块儿想。",
      "reader_knowledge": "读者已知：他的记忆对不上",
      "reveal_chapter": 2,
      "reveal_status": "部分揭示",
      "story_time": "2000年9月·开学第二天",
      "updated_chapter": 2
    },
    "E004": {
      "characters": [
        "沈亦舟",
        "陈小满"
      ],
      "first_recorded_chapter": 2,
      "id": "E004",
      "objective_fact": "他在陈家早点摊随口说了一句“碱放早了”，说完就往学校走，没当回事；是她妈记住了这句话。",
      "reader_knowledge": "读者已知：他不觉得这是本事",
      "reveal_chapter": 2,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·开学第二天",
      "updated_chapter": 2
    },
    "E005": {
      "characters": [
        "沈亦舟",
        "李国强",
        "沈建国"
      ],
      "first_recorded_chapter": 3,
      "id": "E005",
      "objective_fact": "李国强上门炫耀东郊三十万建材大单并羞辱沈建国；沈亦舟三问问崩，李国强当场去院里打电话求证后离席，留下一瓶酒。",
      "reader_knowledge": "读者已知：他借小孩身份说话，功劳给了老爸",
      "reveal_chapter": 3,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·一顿饭的工夫",
      "updated_chapter": 3
    },
    "E006": {
      "characters": [
        "沈亦舟",
        "沈建国",
        "李秀兰"
      ],
      "first_recorded_chapter": 4,
      "id": "E006",
      "objective_fact": "老爸自己说出我也该去查查，把学校健康表折两折揣进裤兜；这是本世老爸第一次主动要去看病",
      "reader_knowledge": "读者已知：老爸松口了，是被一张表说动的，不是被儿子说动的",
      "reveal_chapter": 4,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·一个礼拜天到周一",
      "updated_chapter": 4
    },
    "E007": {
      "characters": [
        "沈亦舟",
        "陈默"
      ],
      "first_recorded_chapter": 5,
      "id": "E007",
      "objective_fact": "陈默入伙：周三陈默去网吧，周六来沈家，他被明令不许问从哪儿学的；班底第一位成员落位",
      "reader_knowledge": "读者已知：这孩子收了个跟班，规矩是他定的，理由一个字没给",
      "reveal_chapter": 5,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·一个下午到傍晚",
      "updated_chapter": 5
    },
    "E008": {
      "characters": [
        "沈亦舟",
        "沈建国"
      ],
      "first_recorded_chapter": 6,
      "id": "E008",
      "objective_fact": "体检结果出来：大三阳、转氨酶高、脾大。他知道这是什么，老爸只知道医生说自己运气好",
      "reader_knowledge": "读者已知：老爸的病被医生点出来了，严重到什么程度只有儿子明白",
      "reveal_chapter": 6,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·体检后的第二天",
      "updated_chapter": 6
    },
    "E009": {
      "characters": [
        "沈亦舟",
        "刘虎"
      ],
      "first_recorded_chapter": 7,
      "id": "E009",
      "objective_fact": "他在砖厂后头用巧劲放倒收过路费的刘虎两次，没有打架、没有流血、没有留伤",
      "reader_knowledge": "读者已知：这个九岁孩子会动手，而且懂得不下重手",
      "reveal_chapter": 7,
      "reveal_status": "已揭示",
      "story_time": "2000年9月·放学后",
      "updated_chapter": 7
    },
    "E010": {
      "characters": [
        "沈亦舟",
        "抱书包的小孩"
      ],
      "first_recorded_chapter": 8,
      "id": "E010",
      "objective_fact": "那孩子说他打架像我哥，问哥哥在哪儿，答不知道、走了；下午塞给他一块用剩的橡皮",
      "reader_knowledge": "读者已知：这孩子有个哥哥，走了；去向成谜",
      "reveal_chapter": 8,
